# OpenStack Topology Explorer Environment Configuration

# Application
DEBUG=false
APP_NAME="OpenStack Topology Explorer"
APP_VERSION="1.0.0"

# Demo Mode - Set to true for demo topology without OpenStack
DEMO_MODE=true

# OpenStack Authentication
# Option 1: Use clouds.yaml (recommended)
# OS_CLOUD=topology
# CLOUDS_YAML_PATH=/path/to/clouds.yaml

# Option 2: Use environment variables
# OS_AUTH_URL=https://keystone.example.com/v3
# OS_USERNAME=topology-reader
# OS_PASSWORD=CHANGE_ME
# OS_PROJECT_NAME=admin
# OS_USER_DOMAIN_NAME=Default
# OS_PROJECT_DOMAIN_NAME=Default
# OS_REGION_NAME=RegionOne

# TLS
TLS_VERIFY=true

# PostgreSQL cache used by Docker Compose. Change both password values together.
POSTGRES_DB=topology
POSTGRES_USER=topology
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://topology:CHANGE_ME@postgres:5432/topology
# For backend-only local development without PostgreSQL:
# DATABASE_URL=sqlite:///./topology.db

# Sync
TOPOLOGY_SYNC_INTERVAL=60

# Classification
CLASSIFICATION_CONFIG_PATH=./config/classification.yaml

# Aggregation
VM_AGGREGATION_THRESHOLD=10

# CORS (JSON arrays and comma-separated values are both supported)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Timeouts
OPENSTACK_TIMEOUT=30
REQUEST_TIMEOUT=60
